# Cloudflare Pages headers. Vite copies public/ into dist/ at build time.
#
# The asset filename is content-hashed by Vite, so it is safe to cache forever.
# index.html must NOT be, or a deploy will not reach returning visitors.

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
